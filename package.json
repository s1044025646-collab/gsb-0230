{
  "name": "bt-meta-checker",
  "version": "1.0.0",
  "description": "本地 BitTorrent v1 元信息解析与分片校验后端（仅离线，API + CLI）",
  "type": "module",
  "main": "dist/src/server.js",
  "bin": {
    "btcheck": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings=ExperimentalWarning dist/src/server.js",
    "serve": "npm run build && node --no-warnings=ExperimentalWarning dist/server.js",
    "gen-samples": "node --no-warnings=ExperimentalWarning dist/scripts/generate-samples.js",
    "demo": "npm run build && node --no-warnings=ExperimentalWarning dist/scripts/demo.js",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  }
}
